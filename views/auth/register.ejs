<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign up - Job Connect</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3135/3135715.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="au-page">

        <aside class="au-side">
            <a href="/" class="au-brand">
                <span class="lp-logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
                </span>
                Job Connect
            </a>

            <div>
                <h2>Your next move starts here</h2>
                <p>Join as a job seeker to apply fast, or as HR to find your next hire.</p>
                <div class="au-badges">
                    <span>Job Seeker</span>
                    <span>HR</span>
                </div>
            </div>

            <small>Job Connect Indonesia</small>
        </aside>

        <main class="au-main">
            <div class="au-card">
                <h1>Create your account</h1>
                <p>Takes less than a minute.</p>

                <form action="/register" method="POST">
                    <div class="au-field">
                        <label for="name">Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="form-control-custom"
                            placeholder="Your full name"
                            required>
                    </div>

                    <div class="au-field">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control-custom"
                            placeholder="you@email.com"
                            required>
                    </div>

                    <div class="au-field">
                        <label for="password">Password</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control-custom"
                            placeholder="At least 6 characters"
                            required>
                    </div>

                    <div class="au-field">
                        <label for="role">I'm signing up as</label>
                        <select id="role" name="role" class="form-control-custom" required>
                            <option value="jobseeker">Job Seeker</option>
                            <option value="hrd">HR</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-blue au-submit">
                        Sign up
                    </button>
                </form>

                <p class="au-foot">
                    Already have an account?
                    <a href="/login">Log in</a>
                </p>

                <p class="au-foot">
                    <a href="/">Back to home</a>
                </p>
            </div>
        </main>

    </div>
</body>
</html>