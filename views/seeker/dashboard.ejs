<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard - Job Connect</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3135/3135715.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="navbar-custom">
        <a href="/seeker/dashboard">
            <span class="lp-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
            </span>
            Job Connect
        </a>
        <a href="/seeker/portfolio">My portfolio</a>
        <a href="/logout">Log out</a>
        <button class="dark-toggle" onclick="toggleDarkMode()">🌙</button>
    </div>

    <div class="container-box">
        <div class="page-header">
            <h1>Hey, <%= user.name %></h1>
            <p>Find your next role and keep your portfolio on point.</p>

            <div class="quick-actions">
                <a href="/seeker/portfolio" class="btn-green">Edit portfolio</a>
                <a href="#jobs" class="btn-red">Browse jobs</a>
            </div>
        </div>

        <% if (message) { %>
            <div class="alert-message <%= message.type === 'success' ? 'alert-success' : 'alert-warning' %>">
                <%= message.text %>
            </div>
        <% } %>

        <div class="dashboard-card-grid">
            <div class="mini-card metric-card">
                <span class="metric-label">Applications sent</span>
                <h3><%= stats.total_applications || 0 %></h3>
                <p>Everything you've applied to so far.</p>
            </div>

            <div class="mini-card metric-card">
                <span class="metric-label">In review</span>
                <h3><%= stats.total_review || 0 %></h3>
                <p>HR is looking at these right now.</p>
            </div>

            <div class="mini-card metric-card">
                <span class="metric-label">Accepted</span>
                <h3><%= stats.total_accepted || 0 %></h3>
                <p>Applications with good news.</p>
            </div>
        </div>

        <% if (applications.length > 0) { %>
            <div class="section-title">
                <h2>Your applications</h2>
            </div>
        <% } %>

        <% applications.forEach(app => { %>
            <div class="application-card">
                <div class="application-top">
                    <div>
                        <h3><%= app.title %></h3>
                        <p><%= app.company_name %></p>
                    </div>

                    <% if (app.status === "pending") { %>
                        <span class="badge badge-yellow">Pending</span>
                    <% } else if (app.status === "review") { %>
                        <span class="badge badge-blue">In Review</span>
                    <% } else if (app.status === "accepted") { %>
                        <span class="badge badge-green">Accepted</span>
                    <% } else { %>
                        <span class="badge badge-red">Rejected</span>
                    <% } %>
                </div>

                <div class="application-info">
                    <span>
                        <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
                        Applied on <%= new Date(app.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </span>
                </div>

                <% if (app.status === "pending") { %>
                    <p class="status-note">
                        Your application is in. HR hasn't picked it up yet.
                    </p>
                <% } else if (app.status === "review") { %>
                    <p class="status-note">
                        HR is checking out your application. Make sure your portfolio and CV are up to date.
                    </p>
                <% } else if (app.status === "accepted") { %>
                    <div class="status-success-box">
                        <h4>You got accepted, congrats!</h4>
                        <p>
                            Reach out to HR to ask about interviews, schedule,
                            and what comes next.
                        </p>

                        <a href="mailto:<%= app.hrd_email %>?subject=Application follow-up - <%= app.title %>" class="btn-green">
                            Contact HR
                        </a>
                    </div>
                <% } else { %>
                    <p class="status-note">
                        This one wasn't a match this time. Keep going, there are more roles out there.
                    </p>
                <% } %>
            </div>
        <% }) %>

        <div class="section-title" id="jobs">
            <h2>Latest jobs</h2>
        </div>

        <% if (jobs.length === 0) { %>
            <div class="alert-empty">
                <span class="lp-ic">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                </span>
                <h3>No jobs yet</h3>
                <p>Openings from companies will show up here.</p>
            </div>
        <% } else { %>
            <% jobs.forEach(job => { %>
                <div class="card-job">
                    <h3><%= job.title %></h3>

                    <div class="job-meta">
                        <span>
                            <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/></svg>
                            <%= job.company_name %>
                        </span>
                        <span>
                            <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
                            Deadline: <%= new Date(job.deadline).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </span>
                    </div>

                    <p><strong>Description</strong><br><%= job.description %></p>
                    <p><strong>Requirements</strong><br><%= job.requirement %></p>

                    <a href="/seeker/apply/<%= job.id %>" class="btn-blue">
                        Apply now
                    </a>
                </div>
            <% }) %>
        <% } %>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>