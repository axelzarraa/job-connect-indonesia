<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My portfolio - Job Connect</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3135/3135715.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="navbar-custom">
        <a href="/seeker/dashboard">
            <span class="lp-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
            </span>
            Job Connect
        </a>
        <a href="/seeker/portfolio">My portfolio</a>
        <a href="/logout">Log out</a>
        <button class="dark-toggle" onclick="toggleDarkMode()">🌙</button>
    </div>

    <div class="container-box" style="max-width: 760px;">
        <div class="page-header">
            <h1>My portfolio</h1>
            <p>A solid profile helps HR say yes faster. Keep it fresh.</p>
        </div>

        <form action="/seeker/portfolio" method="POST" enctype="multipart/form-data" class="form-card">

            <div class="au-field">
                <label for="skill">Skills</label>
                <textarea
                    id="skill"
                    name="skill"
                    rows="4"
                    class="form-control-custom"
                    placeholder="e.g. HTML, CSS, JavaScript, React"
                    required><%= portfolio ? portfolio.skill : "" %></textarea>
            </div>

            <div class="au-field">
                <label for="education">Education</label>
                <textarea
                    id="education"
                    name="education"
                    rows="4"
                    class="form-control-custom"
                    placeholder="e.g. Vocational high school, Software Engineering"
                    required><%= portfolio ? portfolio.education : "" %></textarea>
            </div>

            <div class="au-field">
                <label for="experience">Experience</label>
                <textarea
                    id="experience"
                    name="experience"
                    rows="4"
                    class="form-control-custom"
                    placeholder="e.g. Built a company profile website, interned at a design studio"
                    required><%= portfolio ? portfolio.experience : "" %></textarea>
            </div>

            <div class="au-field">
                <label for="cv">Upload your CV</label>
                <input type="file" id="cv" name="cv" class="form-control-custom">
            </div>

            <% if (portfolio && portfolio.cv) { %>
                <div class="file-current">
                    <span class="lp-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/></svg>
                    </span>
                    <div>
                        <strong>Current CV</strong>
                        <a href="/uploads/<%= portfolio.cv %>" target="_blank">View CV</a>
                    </div>
                </div>
            <% } %>

            <div class="form-actions">
                <button type="submit" class="btn-blue">Save portfolio</button>
                <a href="/seeker/dashboard" class="btn-ghost">Back</a>
            </div>

        </form>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>