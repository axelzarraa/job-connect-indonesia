<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Jobs - Job Connect</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3135/3135715.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="navbar-custom">
        <a href="/hrd/dashboard">
            <span class="lp-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>
            </span>
            Job Connect
        </a>
        <a href="/hrd/jobs">Jobs</a>
        <a href="/hrd/applications">Applicants</a>
        <a href="/logout">Log out</a>
        <button class="dark-toggle" onclick="toggleDarkMode()">🌙</button>
    </div>

    <div class="container-box">
        <div class="page-header">
            <h1>Your jobs</h1>
            <p>Create openings and keep an eye on what's live.</p>

            <div class="quick-actions">
                <a href="/hrd/jobs/create" class="btn-green">Post a job</a>
                <a href="/hrd/dashboard" class="btn-red">Back to dashboard</a>
            </div>
        </div>

        <div class="section-title">
            <h2>All jobs</h2>
        </div>

        <% if (jobs.length === 0) { %>
            <div class="alert-empty">
                <span class="lp-ic">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.7 4H7.3a2 2 0 0 0-1.8 1.1z"/></svg>
                </span>
                <h3>No jobs yet</h3>
                <p>Post your first opening and applicants will start rolling in.</p>
            </div>
        <% } else { %>
            <% jobs.forEach(job => { %>
                <div class="card-job">
                    <h3><%= job.title %></h3>

                    <div class="job-meta">
                        <span>
                            <svg class="ic-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
                            Deadline: <%= new Date(job.deadline).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        </span>
                        <span><i class="dot-live"></i>Active</span>
                    </div>

                    <p><strong>Description</strong><br><%= job.description %></p>
                    <p><strong>Requirements</strong><br><%= job.requirement %></p>

                    <a href="/hrd/applications" class="btn-blue">View applicants</a>
                </div>
            <% }) %>
        <% } %>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>