<!DOCTYPE html>
<html>
<head>
    <title>Job Connect Indonesia</title>
    <link rel="icon" href="https://cdn-icons-png.flaticon.com/512/3135/3135715.png">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="landing-navbar">
        <div class="brand">
    💼 Job Connect
</div>
        <div>
            <a href="/login">Login</a>
            <a href="/register" class="nav-register">Register</a>
        </div>
    </div>

    <div class="hero">
        <div class="hero-content">
            <h1>Temukan Karier Impianmu</h1>
            <p>
                Platform rekrutmen modern yang menghubungkan perusahaan terbaik
                dengan talenta terbaik Indonesia.
            </p>

            <div class="search-demo">

    <input
        type="text"
        placeholder="Cari posisi, misalnya Frontend Developer">

    <button class="btn-blue">
        Cari Lowongan
    </button>

</div>
            <div class="hero-buttons">
                <a href="/login" class="btn-blue">Mulai Sekarang</a>
                <a href="/register" class="btn-green">Buat Akun</a>
            </div>
        </div>
    </div>

    <section class="stats-section">
        <div class="stat-box">
            <h2>100+</h2>
            <p>Lowongan Tersedia</p>
        </div>

        <div class="stat-box">
            <h2>50+</h2>
            <p>Perusahaan Terdaftar</p>
        </div>

        <div class="stat-box">
            <h2>500+</h2>
            <p>Job Seeker Aktif</p>
        </div>
    </section>

    <section class="features-section">
        <h2>Mengapa Memilih Job Connect?</h2>

        <div class="feature-grid">
            <div class="feature-card">
                <h3>🔍 Cari Lowongan</h3>
                <p>Temukan berbagai lowongan pekerjaan dari perusahaan terpercaya.</p>
            </div>

            <div class="feature-card">
                <h3>📄 Upload CV</h3>
                <p>Simpan portfolio dan CV untuk meningkatkan peluang diterima.</p>
            </div>

            <div class="feature-card">
                <h3>🏢 Kelola Kandidat</h3>
                <p>HRD dapat mengelola pelamar dengan mudah dan efisien.</p>
            </div>
        </div>
    </section>

<section class="tech-section">

    <h2>Dibangun Menggunakan</h2>

    <div class="tech-grid">

        <span>Node.js</span>
        <span>Express.js</span>
        <span>MySQL</span>
        <span>EJS</span>
        <span>CSS3</span>

    </div>

</section>

<section class="tech-section">

    <h2>Kategori Populer</h2>

    <div class="tech-grid">

        <span>Frontend Developer</span>
        <span>Backend Developer</span>
        <span>UI/UX Designer</span>
        <span>Data Analyst</span>
        <span>Digital Marketing</span>
        <span>Project Manager</span>

    </div>

</section>
<footer class="footer">

    <h3>Job Connect Indonesia</h3>

    <p>
        Platform rekrutmen modern yang menghubungkan talenta dan perusahaan.
    </p>

    <p>
        Developed by Bes • Node.js • Express • MySQL
    </p>

</footer>

